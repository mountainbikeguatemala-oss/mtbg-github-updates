<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: an upgrade keeps the jobs as the site set them (e.g. paused) -->
    <data noupdate="1">
        <record id="ir_cron_check_updates" model="ir.cron">
            <field name="name">Updates: check GitHub for new versions</field>
            <field name="model_id" ref="model_mtbg_github_source"/>
            <field name="state">code</field>
            <field name="code">model._cron_check()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <!-- finishes an update after the server restarted, nobody watching (triggered by the update; daily as a net) -->
        <record id="ir_cron_finish_updates" model="ir.cron">
            <field name="name">Updates: finish updates after a restart</field>
            <field name="model_id" ref="model_mtbg_github_update"/>
            <field name="state">code</field>
            <field name="code">model._cron_finish_restarted()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_retention" model="ir.cron">
            <field name="name">Updates: remove old backups</field>
            <field name="model_id" ref="model_mtbg_github_batch"/>
            <field name="state">code</field>
            <field name="code">model._cron_retention()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
